DTPAY_DB_HOST=localhost
DTPAY_DB_PORT=3306
DTPAY_DB_USER=
DTPAY_DB_PASSWORD=
DTPAY_DB_NAME=

ANTHROPIC_API_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@dtpay.example

# The on-demand API rejects any request spanning more than this many
# days (inclusive of both start_date and end_date). Change and
# restart the API process - no code change needed.
MAX_DATE_RANGE_DAYS=7

# Keep this "true" until you've read a few days of output in
# review_output/ - flip to "false" only once you trust it unattended.
REVIEW_MODE=true
REVIEW_OUTPUT_DIR=./review_output

# How long to wait before giving up - on connecting to the DB, on a
# query actually returning, and on the Claude API responding. Without
# these, a stuck connection or an unreachable API just hangs forever
# with no error at all, which is exactly what happened once already.
DB_CONNECT_TIMEOUT_SECONDS=10
DB_READ_TIMEOUT_SECONDS=30
CLAUDE_TIMEOUT_SECONDS=60

# When true, every Claude call logs its full prompt (system + message
# payload) and raw response to agent.log - off by default (a payload
# can run to several KB per call), turn on only while debugging.
LOG_CLAUDE_PROMPTS=false

# Services with fewer resolved transactions than this in a week are
# excluded before analysis - a handful of hits isn't a real signal.
MIN_RESOLVED_THRESHOLD=100

# The on-demand API rejects any request spanning more than this many
# days (inclusive of both start_date and end_date). Change and
# restart the API process - no code change needed.
MAX_DATE_RANGE_DAYS=7

# Hard cap on how many questions one chat session allows - the 5th
# question is still answered, a 6th attempt is rejected outright.
MAX_QUESTIONS_PER_SESSION=5

# Redis cache for /summary - a repeat request for the same date range
# and product is served from here instead of re-running the pipeline.
REDIS_HOST=78.46.81.240
REDIS_PORT=5269
REDIS_DB=
REDIS_PASSWORD=

# A range that includes today gets the shorter TTL - that data is
# still capable of changing as transactions keep resolving through
# the day. A fully historical range gets the longer one.
SUMMARY_CACHE_TTL_SECONDS=86400
SUMMARY_CACHE_TTL_TODAY_SECONDS=14400